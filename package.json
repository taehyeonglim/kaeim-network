{
  "name": "kaeim-research-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data": "python3 scripts/build_data.py && node scripts/layout.mjs && node scripts/layout-3d.mjs && npm run data:sna",
    "test": "node --test scripts/public-data.test.mjs && tsx --test src/model.test.ts src/graph3d.test.ts src/sna/engine.test.ts",
    "test:source": "python3 scripts/test_identity_review.py && python3 scripts/test_data.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:3d": "node scripts/layout-3d.mjs",
    "data:sna": "tsx scripts/build-sna.ts",
    "audit:sna": "tsx scripts/audit-sna.ts",
    "social:image": "node scripts/build-social-image.mjs",
    "brand:icons": "node scripts/build-favicons.mjs"
  },
  "dependencies": {
    "d3-force-3d": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-gexf": "^0.13.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-3d": "^1.29.2",
    "seedrandom": "^3.0.5",
    "sigma": "^3.0.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.4.0"
  }
}
